{
    "name": "Orbit Grabber",
    "description": "A tool to quickly and easily insert articles into Orbit to read.",
    "version": "1.0",
    "manifest_version": 3,
    "action": {
        "default_popup": "extension.html",
        "default_icon": "icon-128.png"
    },
    "host_permissions": [
        "https://fastlit.netlify.app/read"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "activeTab",
        "scripting"
    ]
}
